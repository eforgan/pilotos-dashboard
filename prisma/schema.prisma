// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String
  role               String   @default("PILOT") // "ADMIN", "BASE_SUPERVISOR" or "PILOT"
  assignedBase       String?  // BASE name this user supervises, only used when role = "BASE_SUPERVISOR"
  mustChangePassword Boolean  @default(true)
  pilotId            String?  @unique
  pilot              Pilot?   @relation(fields: [pilotId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  fratForms  FratForm[]
  flightLogs FlightLog[]
}

model Pilot {
  id              String   @id @default(cuid())
  PILOTO          String
  TELEFONO        String?
  EMAIL           String?
  DNI             String?  @unique
  FECHA_NAC       String?
  LICENCIA        String?
  CMA             String?
  AW109           String?
  BO105           String?
  RH44            String?
  BN2B            String?
  CONTROL_BIENAL  String?
  INSP_RECONOC    String?
  SIMULADOR       String?
  CTRL_IDONEIDAD  String?
  CTRL_RUTA       String?
  CTRL_VLO_INST   String?
  EXP_RECIENTE    String?
  ULT_FOLIADO     String?
  CRM_FFHH        String?
  MERC_PELIGROSAS String?
  INTERF_ILICITA  String?
  MOE             String?
  SMS             String?
  CURSO_AERONAVE  String?
  VACACIONES      String?
  INSP_IR         String?
  BASE            String?
  HUET            String?
  RO              String?
  
  // Auth & Profile Data
  imageUrl        String?
  inviteToken     String?  @unique
  user            User?
  documents       Document[]
  fratForms       FratForm[]
  flightLogs      FlightLog[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Document {
  id                String   @id @default(cuid())
  type              String   // e.g., "CMA", "LICENCIA", "SIMULADOR"
  fileUrl           String
  fileName          String
  pilotId           String
  pilot             Pilot    @relation(fields: [pilotId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  verified          Boolean  @default(false)
  verifiedSignature String?  // data URL of the verifier's handwritten signature
}

enum FratType {
  TRAINING
  DAILY_OPS
}

enum FratRiskLevel {
  ACCEPTABLE
  CAUTION
  HIGH_RISK
}

model FratForm {
  id             String        @id @default(cuid())
  type           FratType

  pilotId        String?
  pilot          Pilot?        @relation(fields: [pilotId], references: [id])
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id])

  flightDate     DateTime
  base           String?
  aircraft       String?
  picName        String
  sicName        String?
  route          String?
  etd            String?
  missionType    String?
  crewModality   String?

  // { [itemId]: { initial: 0|1|2, final: 0|1|2, mitigation?: string } }
  responses      Json

  initialScore   Int
  finalScore     Int
  maxScore       Int
  riskLevel      FratRiskLevel
  finalRiskLevel FratRiskLevel

  generalNotes   String?
  decision       String?
  picSignature   String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([pilotId])
  @@index([flightDate])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorEmail  String?
  action      String
  entityType  String
  entityId    String
  diff        Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Base {
  id          String     @id @default(cuid())
  name        String
  client      String
  location    String
  description String?
  aircraft    Aircraft[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Aircraft {
  id         String   @id @default(cuid())
  model      String
  tailNumber String   @unique
  baseId     String
  base       Base     @relation(fields: [baseId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([baseId])
}

model FlightLog {
  id          String   @id @default(cuid())

  pilotId     String?
  pilot       Pilot?   @relation(fields: [pilotId], references: [id])
  pilotName   String

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  date        DateTime
  aircraft    String
  tailNumber  String
  route       String?

  dayHours    Float    @default(0)
  nightHours  Float    @default(0)
  ifrHours    Float    @default(0)
  landings    Int      @default(0)
  totalHours  Float    @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pilotId])
  @@index([date])
}

